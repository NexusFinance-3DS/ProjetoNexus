# MySQL 8.0.16+ / 8.4. Crie nexus_finance antes de migrar.
DATABASE_URL=mysql+pymysql://nexus:troque-esta-senha@localhost:3306/nexus_finance?charset=utf8mb4
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081","http://localhost:19006"]
STORAGE_DIR=./storage
SESSION_DAYS=7
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
# Em desenvolvimento, sem SMTP, emails ficam em storage/outbox (somente no servidor).

TIME_ZONE=America/Sao_Paulo
# Apenas para docker compose: substitua os valores abaixo.
MYSQL_PASSWORD=troque-por-uma-senha-longa
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-longa
