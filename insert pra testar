-- =========================================================
-- 26. VER TODAS AS TRANSAÇÕES
-- =========================================================

SELECT
    t.id_transacao,
    t.descricao,
    tt.nome AS tipo,
    c.nome AS categoria,
    st.nome AS status,
    t.valor,
    t.data_transacao
FROM transacoes t

JOIN tipos_transacao tt
    ON tt.id_tipo_transacao = t.id_tipo_transacao

JOIN categorias c
    ON c.id_categoria = t.id_categoria

JOIN status_transacao st
    ON st.id_status_transacao = t.id_status_transacao

WHERE t.id_usuario = 1

ORDER BY t.data_transacao DESC;


-- =========================================================
-- 27. RESUMO POR MÊS
-- =========================================================

SELECT

    DATE_FORMAT(t.data_transacao, '%Y-%m') AS mes,

    SUM(
        CASE
            WHEN tt.nome = 'Receita'
             AND st.nome = 'Confirmada'
            THEN t.valor
            ELSE 0
        END
    ) AS receitas,

    SUM(
        CASE
            WHEN tt.nome = 'Despesa'
             AND st.nome = 'Confirmada'
            THEN t.valor
            ELSE 0
        END
    ) AS despesas,

    SUM(
        CASE
            WHEN tt.nome = 'Receita'
             AND st.nome = 'Confirmada'
            THEN t.valor

            WHEN tt.nome = 'Despesa'
             AND st.nome = 'Confirmada'
            THEN -t.valor

            ELSE 0
        END
    ) AS resultado_mes

FROM transacoes t

JOIN tipos_transacao tt
    ON tt.id_tipo_transacao = t.id_tipo_transacao

JOIN status_transacao st
    ON st.id_status_transacao = t.id_status_transacao

WHERE t.id_usuario = 1

GROUP BY
    YEAR(t.data_transacao),
    MONTH(t.data_transacao)

ORDER BY
    YEAR(t.data_transacao),
    MONTH(t.data_transacao);


-- =========================================================
-- 28. PROGRESSO DAS METAS
-- =========================================================

SELECT

    m.id_meta,

    m.nome,

    m.valor_objetivo,

    COALESCE(
        SUM(
            CASE
                WHEN mm.tipo = 'deposito'
                    THEN mm.valor

                WHEN mm.tipo = 'retirada'
                    THEN -mm.valor
            END
        ),
        0
    ) AS valor_atual,

    ROUND(
        (
            COALESCE(
                SUM(
                    CASE
                        WHEN mm.tipo = 'deposito'
                            THEN mm.valor

                        WHEN mm.tipo = 'retirada'
                            THEN -mm.valor
                    END
                ),
                0
            )
            /
            m.valor_objetivo
        ) * 100,
        2
    ) AS porcentagem,

    m.status

FROM metas m

LEFT JOIN movimentacoes_metas mm
    ON mm.id_meta = m.id_meta

WHERE m.id_usuario = 1

GROUP BY
    m.id_meta,
    m.nome,
    m.valor_objetivo,
    m.status

ORDER BY m.id_meta;
