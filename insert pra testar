-- =========================================================
-- 1. CONTA DE TESTE
-- =========================================================

INSERT INTO contas (
    id_usuario,
    id_tipo_conta,
    nome,
    saldo_inicial,
    ativa
)
SELECT
    1,
    (
        SELECT id_tipo_conta
        FROM tipos_conta
        WHERE nome = 'Conta Corrente'
        LIMIT 1
    ),
    'Conta Principal',
    1500.00,
    TRUE
WHERE NOT EXISTS (
    SELECT 1
    FROM contas
    WHERE id_usuario = 1
      AND nome = 'Conta Principal'
);


SET @CONTA = (
    SELECT id_conta
    FROM contas
    WHERE id_usuario = 1
      AND nome = 'Conta Principal'
    ORDER BY id_conta DESC
    LIMIT 1
);


